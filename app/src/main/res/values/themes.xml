<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0E1020</item>
        <item name="android:colorBackground">#FF0E1020</item>
    </style>

    <style name="Theme.SettingsPanel" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorBackground">@android:color/transparent</item>
    </style>

    <!-- Diálogos e menus: escuro e claro. A cor de destaque dos botões é aplicada em código. -->
    <style name="Dialog.Dark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackgroundFloating">#FF1B1E2B</item>
        <item name="android:colorBackground">#FF1B1E2B</item>
        <item name="android:textColorPrimary">#FFF4F5FA</item>
        <item name="android:textColorSecondary">#B3F4F5FA</item>
        <item name="android:textColorHint">#809AA0AC</item>
    </style>

    <style name="Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorBackgroundFloating">#FFFFFFFF</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#FF15171F</item>
        <item name="android:textColorSecondary">#B315171F</item>
        <item name="android:textColorHint">#8015171F</item>
    </style>
</resources>
